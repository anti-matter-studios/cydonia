{
    "name": "@anti-matter-studios/toolchain",
    "version": "2026.1.1",
    "description": "Suite of configuration for Anti-Matter Studios.",
    "type": "module",
    "exports": {
        "./prettier": {
            "types": "./dist/prettier/index.d.ts",
            "default": "./dist/prettier/index.js"
        },
        "./eslint": {
            "types": "./dist/eslint/index.d.ts",
            "default": "./dist/eslint/index.js"
        },
        "./eslint/react": {
            "types": "./dist/eslint/react.d.ts",
            "default": "./dist/eslint/react.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "default": "./dist/vite/index.js"
        }
    },
    "scripts": {
        "build": "tsc --project ./tsconfig.lib.json",
        "lint": "eslint src/**/*.ts --max-warnings=0",
        "test": "bun test src"
    },
    "dependencies": {
        "@eslint/js": "9.39.5",
        "@tailwindcss/vite": "4.3.3",
        "@vitejs/plugin-react": "6.0.3",
        "@vitest/coverage-v8": "4.1.10",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-tailwindcss": "4.2.0",
        "jsdom": "29.1.1",
        "prettier-plugin-packagejson": "3.0.2",
        "tailwindcss": "catalog:build",
        "typescript-eslint": "8.64.0",
        "vitest": "catalog:test"
    },
    "devDependencies": {
        "@anti-matter-studios/ui": "workspace:*",
        "@types/bun": "catalog:types",
        "@types/eslint-plugin-jsx-a11y": "6.10.1",
        "@types/eslint-plugin-promise": "7.3.0",
        "@types/node": "catalog:types",
        "eslint": "catalog:lint",
        "prettier": "catalog:lint",
        "typescript": "catalog:build"
    },
    "peerDependencies": {
        "eslint": "catalog:lint",
        "prettier": "catalog:lint",
        "vite": "catalog:build"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        },
        "prettier": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
