{
    "name": "@anti-matter-studios/ui",
    "version": "2026.1.1",
    "private": true,
    "description": "Portfolio application used to list all the Anti-Matter Studio projects.",
    "type": "module",
    "exports": {
        "./styles": {
            "source": "./src/index.css",
            "types": "./dist/index.d.ts",
            "default": "./dist/assets/styles.css"
        }
    },
    "scripts": {
        "build": "bun run --sequential build:vite build:declarations",
        "build:declarations": "tsc --project tsconfig.lib.json",
        "build:vite": "vite build",
        "lint": "eslint src --max-warnings=0"
    },
    "dependencies": {
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "tailwindcss": "catalog:build"
    },
    "devDependencies": {
        "@anti-matter-studios/toolchain": "workspace:*",
        "@types/bun": "catalog:types",
        "@types/node": "catalog:types",
        "@types/react": "catalog:types",
        "@types/react-dom": "catalog:types",
        "eslint": "catalog:lint",
        "typescript": "catalog:build",
        "vite": "catalog:build",
        "vitest": "catalog:test"
    }
}
