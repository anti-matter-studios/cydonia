{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://anti-matter.studio/schemas/scripts/sbdb.schema.json",
    "description": "The shape of the object returned by the SBDB API in query mode.",
    "type": "object",
    "properties": {
        "signature": {
            "type": "object",
            "properties": {
                "version": {"type": "string"},
                "source": {"type": "string"}
            },
            "additionalProperties": false,
            "required": ["version", "source"]
        },
        "discovery": {
            "type": "object",
            "description": "Information about the discovery of the object.",
            "properties": {
                "citation": {
                    "oneOf": [
                        {"type": "string"},
                        {"type": "null"}
                    ]
                }
            },
            "additionalProperties": true,
            "required": ["citation"]
        }
    },
    "additionalProperties": true,
    "required": ["signature", "discovery"]
}