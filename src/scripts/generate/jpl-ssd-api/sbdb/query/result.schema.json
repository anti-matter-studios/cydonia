{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://anti-matter.studio/schemas/scripts/sbdb-query.schema.json",
    "description": "The shape of the object returned by the SBDB API in query mode.",
    "type": "object",
    "properties": {
        "signature": {
            "type": "object",
            "properties": {
                "version": {"type": "string"},
                "source": {"type": "string"}
            },
            "additionalProperties": false,
            "required": ["version", "source"]
        },
        "fields": {
            "type": "array",
            "description": "The name of the fields returned for each object.",
            "items": {"type": "string"}
        },
        "data": {
            "type": "array",
            "description": "The data for each object that was retrieved.",
            "items": {
                "type": "array",
                "items": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            }
        },
        "count": {
            "type": "integer"
        }
    },
    "additionalProperties": false,
    "required": ["signature", "count"]
}