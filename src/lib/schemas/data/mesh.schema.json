{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "$id": "https://anti-matter.studio/schemas/data/mesh.schema.json",
    "type": "object",
    "description": "Schema used to validate the mesh data provided to render a planet.",
    "$defs": {
        "colour-source": {
            "type": "string",
            "description": "A six-digit hexadecimal colour value.",
            "pattern": "#?[0-9a-fA-F]{6}"
        },
        "random-generator-seed": {
            "description": "Seed used for deterministic random generation.",
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "type": "string"
                }
            ]
        },
        "layered-simplex-noise-options": {
            "type": "object",
            "description": "Options used when sampling multiple Simplex noise octaves.",
            "properties": {
                "initialAmplitude": {
                    "type": "number",
                    "description": "Output amplitude after octave normalisation.",
                    "minimum": 0
                },
                "offset": {
                    "type": "array",
                    "description": "Domain offset applied after frequency scaling.",
                    "items": {
                        "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                },
                "scale": {
                    "type": "number",
                    "description": "Frequency of the first octave."
                },
                "octaves": {
                    "type": "integer",
                    "description": "Number of octaves to blend together.",
                    "minimum": 0
                },
                "persistence": {
                    "type": "number",
                    "description": "Amplitude multiplier between octaves."
                },
                "lacunarity": {
                    "type": "number",
                    "description": "Frequency multiplier between octaves."
                }
            },
            "additionalProperties": false
        }
    },
    "properties": {
        "radius": {
            "type": "number",
            "description": "Radius of the planet object, for the initial icosahedron subdivision.",
            "minimum": 0
        },
        "subdivisions": {
            "type": "integer",
            "description": "Number of subdivisions applied to the icosahedron.",
            "minimum": 0
        },
        "seed": {
            "$ref": "#/$defs/random-generator-seed"
        },
        "height": {
            "$ref": "#/$defs/layered-simplex-noise-options",
            "description": "Simplex parameters of the height displacement map."
        },
        "specular-light": {
            "$ref": "#/$defs/colour-source",
            "description": "Hexadecimal colour of the specular light reflection."
        },
        "specular-threshold": {
            "type": "number",
            "description": "Threshold for the specular reflection."
        },
        "shade-steps": {
            "type": "number",
            "description": "Number of shading steps applied to the gradient."
        },
        "gradient-light": {
            "$ref": "#/$defs/colour-source",
            "description": "Light colour value of the gradient for the planet."
        },
        "gradient-dark": {
            "$ref": "#/$defs/colour-source",
            "description": "Dark colour value of the gradient for the planet."
        }
    },
    "additionalProperties": false,
    "required": ["seed", "height", "gradient-light", "gradient-dark"]
}
