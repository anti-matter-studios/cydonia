{
    "name": "cydonia",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "bunx --bun vite --config src/config/vite/index.ts",
        "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
        "lint": "bunx --bun eslint . --max-warnings=0",
        "lint:fix": "bunx --bun eslint . --fix",
        "preview": "bunx --bun vite preview",
        "test": "bunx --bun vitest run --config vitest.config.ts",
        "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage --config vitest.config.ts",
        "test:e2e": "bunx --bun playwright test",
        "test:integration": "bunx --bun vitest run --config vitest.integration.config.ts",
        "test:unit": "bunx --bun vitest run --config vitest.unit.config.ts",
        "test:watch": "bunx --bun vitest --config vitest.config.ts",
        "storybook": "storybook dev --port 10102 --exact-port --no-open",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "@storybook/addon-docs": "^10.4.6",
        "@storybook/react-vite": "^10.4.6",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.0.1",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-tailwindcss": "^4.0.5",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "storybook": "^10.4.6",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.2",
        "vitest": "^4.1.9"
    }
}
